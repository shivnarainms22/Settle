# Copy to backend/.env and fill in what you have. Every key is optional: without one, that part runs offline.
# backend/.env is gitignored, so never commit real keys. Links checked 2026-10-24.

# --- Claude agent (Anthropic) -------------------------------------------------------------------------------
# Create a key at https://platform.claude.com/settings/keys (console.anthropic.com redirects there).
# Cal Hacks attendee credits, if offered, are announced by the organizers on Hive/Slack; none are public.
ANTHROPIC_API_KEY=
# Needed when the key is not scoped to a workspace (error: "must include the anthropic-workspace-id header").
# Find it in the Console under Settings -> Workspaces (looks like wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
# SETTLE_AGENT_MODEL=claude-opus-5-5
# SETTLE_PERSONA_LLM=1            # let Claude write customer email prose (recorded for replay)

# --- Moss memory index ----------------------------------------------------------------------------------------
# Sign up at https://portal.usemoss.dev (free tier) for a project id + key. Docs: https://docs.moss.dev
# Then install the extra:  uv sync --extra moss
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# --- Bitdeer AI Model Studio (rerank + cheap email router) ----------------------------------------------------
# 1. Create an account / API key: https://www.bitdeer.ai/en/model/explore
# 2. Request Cal Hacks 13.0 credits:
#    https://docs.google.com/forms/d/e/1FAIpQLSenQ5h8j2zyccRnxb0QLli6isVeb72lT32HjUmKA5v4BCdiNA/viewform
#    (from https://www.bitdeer.ai/en/blog/bitdeer-ai-starter-pack-for-cal-hacks-13-0/)
BITDEER_API_KEY=

# --- Demo safety ----------------------------------------------------------------------------------------------
# SETTLE_REPLAY=1                 # serve backend/cache/recordings.jsonl only; no network calls at all
# SETTLE_AGENT=heuristic          # force the offline agent even if a key is set
